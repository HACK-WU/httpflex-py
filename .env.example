# httpflex 端到端测试环境变量模板（复制为 .env 后填入真实值）
# 真实 Redis 地址、密码等敏感信息请写入 .env（已被 .gitignore 忽略），不要提交到仓库。

HTTPFLEX_TEST_REDIS_HOST=localhost
HTTPFLEX_TEST_REDIS_PORT=6379
HTTPFLEX_TEST_REDIS_PASSWORD=
HTTPFLEX_TEST_REDIS_DB=0
HTTPFLEX_TEST_REDIS_KEY_PREFIX=httpflex_e2e_

# Celery broker / result backend；可写完整 URL，或留空由 conftest 用 REDIS_* 拼接
HTTPFLEX_TEST_CELERY_BROKER=redis://localhost:6379/1
HTTPFLEX_TEST_CELERY_BACKEND=redis://localhost:6379/2